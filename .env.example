# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# On Cloudflare Pages these are set as build-time environment variables instead.

# --- Notion ---------------------------------------------------------------
# Internal integration token, created at https://www.notion.so/my-integrations
#
# After creating it you MUST share the Posts database with the integration
# (open the database -> ... -> Connections -> add it). A token that has not been
# shared returns an EMPTY RESULT SET rather than an error, which looks exactly
# like "the database is empty" and is the most common first-run mistake.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Posts DATABASE id, copied from the database URL in Notion:
#   https://www.notion.so/<workspace>/<THIS_32_CHAR_PART>?v=...
#
# Deliberately a database id and not a data source id: a database id is what an
# exec can actually find in the address bar. The build resolves the data source
# itself (src/lib/notion/datasource.ts), because Notion API 2025-09-03 queries
# data sources rather than databases.
NOTION_DB_POSTS=00000000000000000000000000000000

# --- Deploy ---------------------------------------------------------------
# Cloudflare Pages deploy hook, used by the "Publish now" button at /publish.
#
# The PUBLIC_ prefix is required: Astro only exposes PUBLIC_* variables to
# browser code, and this one has to reach the browser to be clickable.
#
# That means the URL is readable by anyone who loads /publish. It is
# unauthenticated, so anyone who finds it can trigger builds. The worst case is
# a wasted build allowance and a site that stops updating - never a site that
# goes offline - which is why the host had to be one that fails this way.
# Regenerate the hook in the Cloudflare dashboard if it is ever abused.
PUBLIC_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx
