---
// Astro builds this to dist/404.html, which Cloudflare Pages serves for any
// address that doesn't exist. Don't delete it: without a 404.html, Cloudflare
// treats the site as a single-page app and answers every unknown address with
// the homepage, so broken links look like they work.
//
// Old Wix addresses have their own redirects (public/_redirects). This page
// catches the ones nobody found. Its suggestions are the top level of the nav
// (src/config/nav.ts), so they only ever link to pages that exist, and a new
// section appears here as soon as it's added to the nav.
import Base from '../layouts/Base.astro';
import { NAV_ITEMS } from '../config/nav';
---

<Base title="Page not found — McGill NUS" description="This page doesn't exist." noindex>
  <div class="prose-sheet">
    <h1>Page not found</h1>
    <p>Looks like this page called in sick. <span aria-hidden="true">🤒</span> Try one of these instead:</p>
    <ul>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  /* Room to tap the right one. */
  li + li {
    margin-top: 8px;
  }
</style>
