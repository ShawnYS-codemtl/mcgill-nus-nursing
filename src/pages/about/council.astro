---
import Base from '../../layouts/Base.astro';
import CouncilMember from '../../components/CouncilMember.astro';
import JumpLinks from '../../components/JumpLinks.astro';
import { getCouncil } from '../../lib/content';
import { formatTerm } from '../../lib/council-term.mjs';

const council = await getCouncil();
const heading = council ? `Council ${formatTerm(council.term)}` : 'Council';
const sections = council
  ? [
      { id: 'executive-council', title: 'Executive Council', members: council.executive },
      { id: 'general-council', title: 'General Council', members: council.general },
    ].filter(({ members }) => members.length)
  : [];
---

<Base
  title={`${heading} — McGill NUS`}
  description={`Who's on the McGill Nursing Undergraduate Society ${heading.toLowerCase()}, and how to reach them.`}
>
  <h1>{heading}</h1>
  {
    council ? (
      <>
        <JumpLinks links={sections.map(({ id, title }) => ({ id, label: title }))} />
        {sections.map(({ id, title, members }) => (
          <section id={id}>
            <h2>{title}</h2>
            <ul class="card-list">
              {members.map((member) => (
                <CouncilMember member={member} />
              ))}
            </ul>
          </section>
        ))}
      </>
    ) : (
      <div class="card empty">
        <p>This year's council hasn't been posted yet.</p>
      </div>
    )
  }
</Base>

<style>
  h1 {
    margin: 0 0 16px;
  }
  h2 {
    font: var(--text-title-md);
  }
  /* On laptops, two cards to a row, each as wide as on a phone. A row is as
     tall as its taller card. */
  @media (width >= 48rem) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
