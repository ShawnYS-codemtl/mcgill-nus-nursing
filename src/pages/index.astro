---
// The homepage is the news feed (docs/information-architecture.md): the lead
// post, the featured posts, the rest, the event photos, then the Land
// Acknowledgement and the Commitment to Truth & Reconciliation in full.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { LAND_ACKNOWLEDGEMENT, TRUTH_AND_RECONCILIATION } from '../config/indigenous-relations';
import { getGallery, getHomepagePosts } from '../lib/content';

const { lead, leadIsNewest, featured, more } = await getHomepagePosts();
const photos = await getGallery();
---

<Base title="McGill NUS — News" description="News and announcements from the McGill Nursing Undergraduate Society.">
  {/* The News tab already says it. */}
  <h1 class="visually-hidden">News</h1>

  {
    lead ? (
      <PostCard post={lead} variant="lead" newest={leadIsNewest} />
    ) : (
      // The empty state is a real state, not an edge case: "nothing posted in a
      // month" will happen. See PRODUCT.md → Product Principles.
      <div class="card empty">
        <p>No posts yet. Check back soon.</p>
      </div>
    )
  }

  {
    featured.length > 0 && (
      <section>
        <h2>Featured</h2>
        <ul class="card-list">
          {featured.map((post) => (
            <li>
              <PostCard post={post} variant="compact" taped />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    more.length > 0 && (
      <section>
        <h2>More news</h2>
        <ul class="card-list">
          {more.map((post) => (
            <li>
              <PostCard post={post} variant="compact" taped={false} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section>
        <h2>Photos</h2>
        <div class="gallery">
          {photos.map(({ data }) => (
            <figure>
              <div class="print">
                <Image
                  src={data.image}
                  alt={data.alt}
                  widths={[200, 400, 600]}
                  sizes="(min-width: 48rem) 194px, calc(50vw - 56px)"
                />
              </div>
              {data.caption && <figcaption>{data.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {/* Verbatim texts, never edited here or in the CMS: CLAUDE.md decision 13.
      Plain cards: never tilted, taped, stickied or handwritten.
      The id is where every page's footer links (ROUTES.landAcknowledgement). */}
  <section id="land-acknowledgement" class="card verbatim">
    <h2>{LAND_ACKNOWLEDGEMENT.heading}</h2>
    <p>{LAND_ACKNOWLEDGEMENT.text}</p>
  </section>
  <section class="card verbatim">
    <h2>{TRUTH_AND_RECONCILIATION.heading}</h2>
    <p>{TRUTH_AND_RECONCILIATION.text}</p>
  </section>
</Base>

<style>
  /* Section headings sit on the sheet, in its text colour. */
  h2 {
    font: var(--text-title-md);
  }

  /* Taped photos (Figma Taped photo, 77:1310), two to a row, three from
     48rem. Along a row they tilt left, then right; captions stay level.
     minmax(0, …): a long word in a caption wraps instead of widening its
     column (as in .card-list, global.css). */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  @media (width >= 48rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  figure {
    --tilt: -2deg;
    --tape-tilt: 5deg;
    --tape-top: 9px;
    position: relative;
    margin: 0;
    padding-top: 21px;
  }
  figure:nth-child(even) {
    --tilt: 2deg;
    --tape-tilt: -4deg;
    --tape-top: 4px;
  }
  figure::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: var(--tape-top);
    left: calc(50% - 32px);
    width: 64px;
    height: 22px;
    background: var(--tape);
    transform: rotate(var(--tape-tilt));
  }
  .print {
    margin: 0 6px 8px;
    padding: 6px;
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    transform: rotate(var(--tilt));
  }
  .print img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  figcaption {
    font: var(--text-label-sm);
    text-align: center;
  }

  .verbatim {
    margin-top: 32px;
    padding: 20px 18px;
  }
  .verbatim h2 {
    margin: 0 0 8px;
    font: var(--text-title-lg);
  }
  .verbatim p {
    margin: 0;
  }
</style>
