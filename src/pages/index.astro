---
import Base from '../layouts/Base.astro';
import { getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title="McGill NUS — News" description="News and announcements from the McGill Nursing Undergraduate Society.">
  <h1>News</h1>

  {
    posts.length === 0 ? (
      // The empty state is a real state, not an edge case: "nothing posted in a
      // month" will happen. See PRODUCT.md → Product Principles.
      <p>No posts yet. Check back soon.</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={post.data.externalLink ?? `/news/${post.data.slug}/`}>{post.data.title}</a>
            <br />
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {dateFormat.format(post.data.date)}
            </time>
            <p>{post.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
