---
// /involved/<slug>/: a committee's own page. Only committees without an
// external link get one, which is what the CMS help text promises and what
// tests/redirects.test.mjs checks for the old Wix addresses.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ROUTES } from '../../config/routes';
import { getCommitteesWithPages, type Committee } from '../../lib/content';

export async function getStaticPaths() {
  const committees = await getCommitteesWithPages();
  return committees.map((committee) => ({ params: { slug: committee.data.slug }, props: { committee } }));
}

const { committee } = Astro.props as { committee: Committee };
const { data } = committee;
const { Content } = await render(committee);
const shortDescription = data.shortDescription.trim();
// The CMS shows the short description on the card. Here the page text speaks
// for itself, and the imported texts open with the same words, so it's shown
// only when there is no page text.
const hasText = !!committee.body?.trim();
---

<Base title={`${data.name} — McGill NUS`} description={shortDescription || `${data.name}, at the McGill Nursing Undergraduate Society.`}>
  <article>
    <h1>{data.name}</h1>
    {data.acceptingMembers && <p>Recruiting now</p>}
    {
      /* src/lib/content.ts has already dropped a logo with no description. */
      data.logo && data.logoAlt && <Image class="logo" src={data.logo} alt={data.logoAlt} width={240} height={240} fit="contain" />
    }
    {hasText ? <Content /> : shortDescription && <p>{shortDescription}</p>}
    {
      (data.instagram || data.contactEmail) && (
        <ul>
          {data.instagram && (
            <li>
              <a href={data.instagram}>{data.name} on Instagram</a>
            </li>
          )}
          {data.contactEmail && (
            <li>
              Email: <a href={`mailto:${data.contactEmail}`}>{data.contactEmail}</a>
            </li>
          )}
        </ul>
      )
    }
  </article>

  <p><a href={ROUTES.involved}>Back to Get involved</a></p>
</Base>

<style>
  /* As in src/components/CommitteeCard.astro: the logo, whole, in a square.
     Only the logo: images in the page text keep their own shape. */
  .logo {
    aspect-ratio: 1 / 1;
  }
</style>
