---
// One committee or club on /involved/. It links to the committee's own page,
// or straight to its external link when it has one (no page then: see
// getCommitteesWithPages in src/lib/content.ts).
import { Image } from 'astro:assets';
import { ROUTES } from '../config/routes';
import type { Committee } from '../lib/content';

interface Props {
  committee: Committee;
}

const { data } = Astro.props.committee;
---

<li>
  <h2>
    <a href={data.externalLink ?? ROUTES.committee(data.slug)}>{data.name}</a>
  </h2>
  {
    /* src/lib/content.ts has already dropped a logo with no description. */
    data.logo && data.logoAlt && <Image src={data.logo} alt={data.logoAlt} width={240} height={240} fit="contain" />
  }
  {data.shortDescription.trim() && <p>{data.shortDescription}</p>}
  {data.acceptingMembers && <p>Recruiting now</p>}
</li>

<style>
  /* Not decoration: logos come in every shape, so each is shown whole inside
     the same square. fit="contain" shrinks the file without adding bars, and
     this rule keeps the box square whatever shape the file comes out. */
  img {
    aspect-ratio: 1 / 1;
  }
</style>
