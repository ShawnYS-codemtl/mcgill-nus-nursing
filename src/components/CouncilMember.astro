---
// One council position on /about/council/: a person, or an open seat. The
// words are the council's, edited in Pages CMS → Council. src/lib/content.ts
// has already dropped an email that isn't an address.
import { Image } from 'astro:assets';
import { ROUTES } from '../config/routes';
import type { CouncilMember } from '../lib/content';

interface Props {
  member: CouncilMember;
}

const { data } = Astro.props.member;
---

<li>
  <h3>{data.role}</h3>
  {
    data.vacant ? (
      <>
        <p>Position open</p>
        {data.roleDescription && (
          <dl>
            <dt>What this role does</dt>
            <dd>{data.roleDescription}</dd>
          </dl>
        )}
        <p>
          <a href={ROUTES.elections}>How to run for council</a>
        </p>
      </>
    ) : (
      <>
        {/* The alt is empty because the name is right beside it: a screen
            reader would otherwise read the name twice. */}
        {data.photo && <Image src={data.photo} alt="" width={400} height={500} fit="cover" />}
        {data.name && <p>{data.name}</p>}
        {data.program && <p>{data.program}</p>}
        {(data.roleDescription || data.funFact) && (
          <dl>
            {data.roleDescription && (
              <>
                <dt>What this role does</dt>
                <dd>{data.roleDescription}</dd>
              </>
            )}
            {data.funFact && (
              <>
                <dt>Fun fact</dt>
                <dd>{data.funFact}</dd>
              </>
            )}
          </dl>
        )}
        {data.email && (
          <p>
            <a href={`mailto:${data.email}`}>{data.email}</a>
          </p>
        )}
      </>
    )
  }
</li>

<style>
  /* Not decoration: every photo is the same shape, whatever was uploaded.
     fit="cover" crops a large photo to 4:5, but Astro never enlarges, so a
     photo smaller than 400×500 would keep its own shape without this rule. */
  img {
    aspect-ratio: 4 / 5;
  }
</style>
