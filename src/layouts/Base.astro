---
// Phase 0 shell. Deliberately almost styleless — Phase 0 validates the publish
// loop, not the design. The visual language arrives later, from the design
// brief (docs/design-brief.md). Resist decorating this.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      /* Just enough to be readable on a phone. Not a design. */
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        max-width: 42rem;
        margin: 0 auto;
        padding: 1.5rem;
      }
      a {
        color: #00507a;
      }
      :focus-visible {
        outline: 3px solid #00507a;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">McGill Nursing Undergraduate Society</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
