---
// Phase 0 shell. Deliberately almost styleless — Phase 0 validates the publish
// loop, not the design. The visual language arrives later, from the design
// brief (docs/design-brief.md). Resist decorating this.

// Not decoration: this brings in Astro's small image stylesheet, the rule that
// keeps an image inside its column (astro.config.mjs → image.responsiveStyles).
// Astro only adds it to a page that imports astro:assets itself, and a picture
// in Markdown text (a page's, later a committee's) doesn't count. Without this
// line such a picture shows at full size (found 2026-10-21).
// tests/build.test.mjs checks every page that has an image.
import 'astro:assets';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { ROUTES } from '../config/routes';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      /* Just enough to be readable on a phone. Not a design.
         Global because Astro scopes a component's styles to its own elements:
         without it, the link colour and focus ring reached only the site-title
         link, not the nav, the page or the footer (found 2026-11-01). */
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.6;
        max-width: 42rem;
        margin: 0 auto;
        padding: 1.5rem;
        overflow-wrap: break-word;
      }
      a {
        color: #00507a;
      }
      :focus-visible {
        outline: 3px solid #00507a;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <header>
      <a href={ROUTES.home}>McGill Nursing Undergraduate Society</a>
      <Nav />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
