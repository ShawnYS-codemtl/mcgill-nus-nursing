---
// Not decoration: this brings in Astro's small image stylesheet, the rule that
// keeps an image inside its column (astro.config.mjs → image.responsiveStyles).
// Astro only adds it to a page that imports astro:assets itself, and a picture
// in Markdown text (a page's, later a committee's) doesn't count. Without this
// line such a picture shows at full size (found 2026-10-21).
// tests/build.test.mjs checks every page that has an image.
import 'astro:assets';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { ROUTES } from '../config/routes';
import { seasonOf } from '../lib/season.mjs';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// The season paints the window, sticky and tape (decision 17). The page is
// built with the build date's season, so it is right with JavaScript off; this
// script, run before first paint, corrects it to the visitor's date. It is
// seasonOf's own source, so the two can't disagree. ?season=winter (or fall,
// summer) overrides both, for reviewing every season on a preview.
const seasonScript = `{const s=new URLSearchParams(location.search).get('season');document.documentElement.dataset.season=/^(fall|winter|summer)$/.test(s)?s:(${seasonOf})(new Date())}`;
---

<!doctype html>
<html lang="en" data-season={seasonOf(new Date())}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline set:html={seasonScript} />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-hand" />
  </head>
  <body>
    <header>
      <a href={ROUTES.home}>McGill Nursing Undergraduate Society</a>
      <Nav />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
