# --- Dependencies ---
node_modules/
.pnp/
.pnp.js

# --- Build output ---
dist/
.output/

# --- Astro generated types / cache ---
.astro/

# --- Host / tooling ---
.netlify/
.vercel/

# --- Secrets ---
# The build needs no secrets today. Kept so one added later is never committed.
.env
.env.*

# --- Logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- AI agent harness config & installed skills ---
# The same `impeccable` skill, installed once per harness, plus local hook
# config and question logs. Reinstallable from the plugin; not part of the
# site. Keep this repo about the site — CLAUDE.md at the root stays committed
# and is the only agent-facing file a successor needs.
.agents/
.claude/
.codex/
.cursor/
.impeccable/


# =====================================================================
# DELIBERATELY NOT IGNORED — read before "cleaning this up"
# =====================================================================
#
# src/content/**  and  src/assets/uploads/**
#   This IS the website's content: every post, page, council member and
#   photo, written by council editors through Pages CMS. Each Save in the
#   CMS is a commit here. There is no other copy anywhere — no database,
#   no CMS server. Ignoring or "tidying" these folders deletes the site.
#   See MAINTENANCE.md → Landmines.
# =====================================================================
